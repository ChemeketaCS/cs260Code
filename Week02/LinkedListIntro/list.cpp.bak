#include <iostream>

struct ListNode {
public:
  // Value stored in this node
  int data;
  // Next node in list (nullptr == end of list)
  ListNode* next = nullptr;

  // Node must be constructed with a value - stored as data
  ListNode(int value) {
    data = value;
  }
};

using namespace std;

ListNode* makeList() {
  // Start of a list of nodes
  ListNode* head = new ListNode(10);

  ListNode* temp; // pointer to track new nodes

  temp = new ListNode(12);
  temp->next = head;
  head = temp;

  temp = new ListNode(14);
  temp->next = head;
  head = temp;

  return head;
}

int main() {
  ListNode* head = makeList();

  // Make a pointer to track our position
  ListNode* current = head;
  // When we hit null, we've gotten to end
  while (current != nullptr) {
    cout << current->data << " "; // work
    // advance in the list
    current = current->next;
  }
  cout << endl;

  while (head != nullptr) {
    ListNode* toDelete = head;
    head = head->next;
    delete toDelete;
  }
}
